{
  "name": "github-stats-svg",
  "version": "1.0.0",
  "description": "Generate an all-in-one GitHub stats & top languages SVG dashboard card for your GitHub profile README.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "github-stats-svg": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo --output assets/demo-stats.svg",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "github",
    "readme",
    "stats",
    "svg",
    "github-actions",
    "profile"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
